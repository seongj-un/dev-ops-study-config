- path: /usr/local/bin/duckdns-update
  permissions: "0755"
  content: |
    #!/bin/bash
    # <sub>.duckdns.org를 이 인스턴스의 지금 공인 IPv4로 맞춘다. Elastic IP가 없어서 멈췄다 켜면 공인 IP가 바뀐다.
    # duckdns-update.timer가 부팅 30초 뒤와 그 뒤 5분마다 돌린다. DuckDNS는 dev. 같은 하위 이름에도 같은 IP로 답한다.
    set -euo pipefail
    . /etc/devops/bootstrap.env
    imds=http://169.254.169.254/latest
    # IMDSv2: PUT으로 받은 세션 토큰을 헤더에 실어야 메타데이터를 준다(http_tokens=required라서 토큰 없는 v1 요청은 401).
    t=$(curl -fsS --max-time 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' "$imds/api/token")
    ip=$(curl -fsS --max-time 5 -H "X-aws-ec2-metadata-token: $t" "$imds/meta-data/public-ipv4")
    # 토큰은 인스턴스 역할로 SSM에서 읽는다(user data·Terraform 상태에 남기지 않으려고). SecureString이라 --with-decryption이 KMS로 푼다.
    token=$(aws ssm get-parameter --with-decryption --region "$AWS_REGION" --name "$SSM_PARAMETER_NAME" --query Parameter.Value --output text)
    # 아래 curl 설정 한 줄을 깨뜨리는 글자가 없는지 본다(DuckDNS 토큰은 UUID). 틀려도 값은 출력하지 않는다.
    case $token in ''|*[!0-9a-fA-F-]*) echo "SSM의 DuckDNS 토큰 모양이 이상하다(값은 출력하지 않는다)" >&2; exit 1 ;; esac
    # 토큰이 든 URL을 명령줄 인자로 주지 않는다: 인자는 /proc/<pid>/cmdline(ps)으로 다른 사용자도 읽는다. printf는 bash 내장 명령이라
    # exec되지 않아 인자가 프로세스 목록에 나타나지 않고, curl은 설정을 표준 입력(-K -)으로 받는다. set -x도 쓰지 않는다.
    res=$(printf 'url = "https://www.duckdns.org/update?domains=%s&token=%s&ip=%s"\n' "$DUCKDNS_SUBDOMAIN" "$token" "$ip" | curl -fsS --max-time 30 --retry 3 -K -)
    case $res in
      OK) echo "DuckDNS: $DUCKDNS_SUBDOMAIN.duckdns.org -> $ip" ;;
      KO) echo "DuckDNS가 KO를 돌려줬다: 토큰이나 서브도메인이 틀렸다" >&2; exit 1 ;;
      *) echo "DuckDNS 응답이 OK/KO가 아니다(본문은 출력하지 않는다)" >&2; exit 1 ;;
    esac
- path: /usr/local/sbin/devops-bootstrap
  permissions: "0755"
  content: |
    #!/bin/bash
    # 이 인스턴스를 GitOps 노드로 만든다: AWS CLI → DuckDNS → k3s → Helm → ArgoCD → DB Secret → 루트 Application.
    # devops-bootstrap.service가 부팅마다 돌린다. 단계마다 결과가 이미 있으면 건너뛰므로 손으로 다시 돌려도 된다.
    set -euo pipefail
    # 손으로 돌린 것과 서비스가 겹치면 helm 설치가 두 번 돌 수 있어서 한 번에 하나만 돌게 한다.
    exec 9>/run/devops-bootstrap.lock
    flock -n 9 || { echo "이미 실행 중이다" >&2; exit 1; }
    LOG=/var/log/devops-bootstrap.log
    DONE=/var/lib/devops-bootstrap.done
    echo "로그: $LOG"
    exec >>"$LOG" 2>&1
    . /etc/devops/bootstrap.env
    # systemd는 User=가 없는 서비스에 HOME을 주지 않는데, helm은 캐시·설정 경로를 HOME에서 찾는다.
    export HOME=/root KUBECONFIG=/etc/rancher/k3s/k3s.yaml DEBIAN_FRONTEND=noninteractive
    START=$(date +%s)
    WORK=$(mktemp -d)
    trap 'rm -rf "$WORK"' EXIT
    log() { echo "$(date -u +%FT%TZ) $*"; }
    fail() { log "실패: $*"; exit 1; }
    # 단계마다 "STEP: 이름"을 남겨 로그 끝만 봐도 어디까지 왔는지 보이게 한다. set -e로 멈출 때는 ERR 트랩이 그 단계와
    # 이 파일의 줄 번호·종료 코드·명령을 남긴다. fail로 끝낼 때는 fail이 이유를 남긴다(exit는 ERR 트랩을 부르지 않는다).
    STEP=준비
    step() { STEP=$1; log "STEP: $STEP"; }
    trap 'log "실패: STEP $STEP, $LINENO번 줄, 종료 코드 $?: $BASH_COMMAND"' ERR
    # retry <설명> <제한 초> <명령...>: 성공할 때까지 5초 간격으로 다시 한다. 제한은 첫 시도부터 잰 실제 경과 시간(date +%s)이라
    # 시도 한 번이 오래 걸려도 늘어나지 않는다. 제한이 지난 뒤 실패하면 마지막 시도의 출력을 로그에 남기고 실패한다.
    # 가장 오래 걸리는 경우는 제한 + 5초 + 시도 한 번이다(제한 직전에 시작한 시도는 끝날 때까지 기다린다).
    retry() {
      local what=$1 limit=$2 end
      shift 2
      end=$(($(date +%s) + limit))
      until "$@" >"$WORK/retry.out" 2>&1; do
        [ "$(date +%s)" -lt "$end" ] || { cat "$WORK/retry.out"; fail "$what: $limit초 안에 성공하지 못했다"; }
        sleep 5
      done
      log "확인: $what"
    }
    [ "$(uname -m)" = x86_64 ] || fail "x86_64 전용이다(AWS CLI zip·Helm tarball이 amd64용)"
    log "시작 (이전 완료: $(cat "$DONE" 2>/dev/null || echo 없음))"
    # 완료 표시는 이번 실행이 끝까지 가야 다시 생긴다. 지우지 않으면 이번 부팅에서 실패해도 지난 완료 표시가 남아 성공처럼 보인다.
    rm -f "$DONE"

    # 1. unzip(AWS CLI zip용). 첫 부팅에는 apt-daily·unattended-upgrades가 apt 잠금을 쥐고 있을 수 있어서 잠금을 기다리고 다시 한다.
    step "1/8 unzip"
    if ! command -v unzip >/dev/null; then
      retry "apt-get update" 180 apt-get -o DPkg::Lock::Timeout=60 update
      apt-get -o DPkg::Lock::Timeout=180 install -y -q unzip
    fi

    # 2. AWS CLI v2(SSM에서 DuckDNS 토큰을 읽는다): AWS가 배포하는 zip의 설치 스크립트가 /usr/local/aws-cli에 풀고 /usr/local/bin/aws를 만든다.
    # 버전을 고정하지 않은 최신 zip이라, 같은 주소에 .sig를 붙인 PGP 서명을 AWS CLI 팀 키(/etc/devops/aws-cli.asc)로 검사하고 틀리면 풀기 전에 멈춘다.
    # gpgv는 apt가 저장소 서명 검사에 쓰는 도구라 늘 있다. 키는 ASCII armor라서 머리줄(-----)·빈 줄·체크섬 줄(=)을 빼고 base64를 풀어 키링으로 만든다.
    step "2/8 AWS CLI"
    if ! aws --version >/dev/null 2>&1; then
      log "AWS CLI v2 설치"
      u=https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
      curl -fsSL --retry 5 -o "$WORK/awscliv2.zip" "$u"
      curl -fsSL --retry 5 -o "$WORK/awscliv2.zip.sig" "$u.sig"
      grep -v -e '^-----' -e '^=' -e '^$' /etc/devops/aws-cli.asc | base64 -d >"$WORK/aws-cli.gpg"
      gpgv --keyring "$WORK/aws-cli.gpg" "$WORK/awscliv2.zip.sig" "$WORK/awscliv2.zip"
      unzip -q "$WORK/awscliv2.zip" -d "$WORK"
      "$WORK/aws/install" --update
    fi
    log "$(aws --version)"

    # 3. DuckDNS를 k3s보다 먼저 맞춰 새 공인 IP가 DNS에 일찍 반영되게 한다. 실패해도 계속한다: 클러스터 설치는 DNS와 무관하고
    # 타이머가 5분마다 다시 한다(journalctl -u duckdns-update). timeout 120: SSM·DuckDNS가 응답하지 않아도 여기서 2분 넘게 붙잡히지 않는다.
    # 타이머는 AWS CLI가 생긴 뒤에 켜야 첫 실행이 헛돌지 않는다.
    step "3/8 DuckDNS"
    timeout 120 /usr/local/bin/duckdns-update || log "경고: DuckDNS 갱신 실패. 타이머가 다시 한다"
    systemctl enable --now duckdns-update.timer

    # 4. k3s: 설치 스크립트를 파일로 받아 실행한다(sh로 바로 파이프하면 받다 끊긴 스크립트가 반쯤 실행될 수 있다). 스크립트는 고정한
    # 버전의 바이너리를 받아 같은 릴리스의 sha256 목록으로 검사한다. 이미 그 버전이면 건너뛴다(다시 돌리면 k3s를 재시작한다).
    # --tls-san: API 서버 인증서에 DuckDNS 이름을 넣어 맥에서 https://<sub>.duckdns.org:6443 으로 붙게 한다. 공인 IP는 넣지 않는다:
    # 멈췄다 켤 때마다 바뀌어 인증서의 IP가 곧 틀려지지만, 이름은 DuckDNS가 새 IP로 옮겨 주므로 계속 맞는다.
    # --write-kubeconfig-mode 0600: 관리자 자격 증명(/etc/rancher/k3s/k3s.yaml)을 root만 읽는다. Traefik·metrics-server·local-path는 켜 둔다(로컬과 같다).
    step "4/8 k3s"
    if [ "$(k3s --version 2>/dev/null | awk 'NR==1 {print $3}')" != "$K3S_VERSION" ]; then
      log "k3s $K3S_VERSION 설치"
      curl -fsSL --retry 5 -o "$WORK/k3s-install.sh" https://get.k3s.io
      INSTALL_K3S_VERSION=$K3S_VERSION sh "$WORK/k3s-install.sh" server --tls-san "$DUCKDNS_SUBDOMAIN.duckdns.org" --write-kubeconfig-mode 0600
    fi
    # k3s가 안정될 때까지 기다린다. API의 답 한 번으로는 부족하다: Node의 Ready 조건은 kubelet이 마지막으로 써 둔 값이고, 그것을 Unknown으로
    # 바꾸는 노드 수명 주기 컨트롤러는 kubelet 소식이 일정 시간(node-monitor-grace-period) 끊겨야 움직인다. k3s는 API 서버·컨트롤러·kubelet이
    # 한 프로세스라 함께 죽고 함께 살아나서, 재시작을 되풀이하는 동안에도 Ready=True가 남는다(v1.35.5+k3s1의 첫 부팅이 그랬다. variables.tf).
    # 그래서 5초 간격으로 6번 연속(약 30초) 아래가 모두 맞아야 넘어가고, 하나라도 어긋나면 처음부터 다시 센다. 상한은 600초다.
    #  - /readyz가 ok: 저장된 객체가 아니라 지금 살아 있는 API 서버가 답한다.
    #  - 노드가 Ready이고 node.cloudprovider.kubernetes.io/uninitialized taint가 없다: 내장 클라우드 컨트롤러 매니저(CCM)를 쓰면 k3s가 kubelet을
    #    --cloud-provider=external로 띄워 kubelet이 노드를 처음 등록할 때 이 taint를 붙이고, CCM이 노드를 초기화해야 지운다.
    #  - k3s 서비스의 NRestarts(systemd가 Restart=로 다시 시작한 횟수)가 그동안 그대로다.
    k3s_check() {
      local r
      if ! r=$(kubectl get --raw=/readyz --request-timeout=5s 2>&1) || [ "$r" != ok ]; then
        echo "/readyz: $(printf '%s' "$r" | head -n 1 | cut -c 1-200)"; return 1
      fi
      if ! r=$(kubectl get nodes --request-timeout=5s -o jsonpath='{range .items[*]}{.metadata.name} Ready={.status.conditions[?(@.type=="Ready")].status} {.spec.taints[*].key}{"\n"}{end}' 2>&1); then
        echo "노드 조회: $(printf '%s' "$r" | head -n 1 | cut -c 1-200)"; return 1
      fi
      case $r in
        '') echo "등록된 노드가 없다"; return 1 ;;
        *node.cloudprovider.kubernetes.io/uninitialized*) echo "CCM이 아직 노드를 초기화하지 않았다: $r"; return 1 ;;
      esac
      if printf '%s\n' "$r" | grep -qv ' Ready=True '; then echo "Ready가 아닌 노드가 있다: $r"; return 1; fi
    }
    k3s_settle() {
      local end ok=0 base now r why='' last=''
      end=$(($(date +%s) + 600))
      base=$(systemctl show -p NRestarts --value k3s)
      while :; do
        now=$(systemctl show -p NRestarts --value k3s)
        if [ "$now" = "$base" ] && r=$(k3s_check); then
          ok=$((ok + 1))
          [ "$ok" -lt 6 ] || break
        else
          if [ "$now" = "$base" ]; then why=$r; else why="k3s가 다시 시작됐다(NRestarts $base -> $now)"; fi
          ok=0 base=$now
          [ "$why" = "$last" ] || { log "대기: $why"; last=$why; }
        fi
        [ "$(date +%s)" -lt "$end" ] || fail "k3s가 600초 안에 안정되지 않았다(마지막 이유: $why). k3s 로그는 journalctl -u k3s"
        sleep 5
      done
      log "확인: k3s 안정(6번 연속 통과, NRestarts $now)"
    }
    k3s_settle

    # 5. Helm: 고정한 버전의 공식 tarball을 get.helm.sh의 .sha256sum으로 검사한다. 같은 곳에서 받은 체크섬이라
    # 전송 중 깨지거나 잘린 파일은 잡지만, 배포 서버의 파일이 통째로 바뀐 경우까지 막지는 못한다.
    step "5/8 Helm"
    if [ "$(helm version --template '{{.Version}}' 2>/dev/null)" != "$HELM_VERSION" ]; then
      log "Helm $HELM_VERSION 설치"
      f=helm-$HELM_VERSION-linux-amd64.tar.gz
      curl -fsSL --retry 5 -o "$WORK/$f" "https://get.helm.sh/$f"
      curl -fsSL --retry 5 -o "$WORK/$f.sha256sum" "https://get.helm.sh/$f.sha256sum"
      (cd "$WORK" && sha256sum --check --strict "$f.sha256sum")
      tar -xzf "$WORK/$f" -C "$WORK" linux-amd64/helm
      install -m 0755 "$WORK/linux-amd64/helm" /usr/local/bin/helm
    fi

    # 6. ArgoCD: 로컬과 같은 차트 버전·값으로 설치하되 두 값만 바꾼다.
    # server.ingress.enabled=false: HTTPS(cert-manager)가 생기기 전에는 Ingress를 만들지 않는다. 80 포트는 인터넷에 열려 있어서 만들면
    # admin 비밀번호가 HTTP 평문으로 인터넷을 지나간다. Ingress가 없으면 argocd-server는 ClusterIP라 밖에서 닿지 않는다(그래서 공개 환경에
    # 쓰면 안 되는 server.insecure: true도 그대로 둔다).
    # UI는 맥에서 kubectl -n argocd port-forward svc/argocd-server 8080:80 을 띄우고 http://localhost:8080으로 본다. 인터넷을 건너는 구간은
    # k3s API(6443)의 TLS뿐이다(4단계 --tls-san으로 붙고, 6443은 보안 그룹이 관리자 IP에만 연다).
    # configs.cm.url(ArgoCD의 외부 주소): 값 파일의 로컬 Ingress 주소 대신 위 port-forward 주소로 맞춘다.
    # 릴리스의 상태(helm list가 주는 마지막 리비전의 상태)를 먼저 본다. JSON은 python3로 읽는다(cloud-init이 python3 프로그램이라 Ubuntu에 늘 있다).
    #  - deployed이면 건너뛴다: 값이 바뀌면 user data가 바뀌어 인스턴스를 새로 만들므로 같은 인스턴스에서는 값이 그대로다.
    #  - pending-install·pending-upgrade·pending-rollback: helm이 작업 도중 끊겼다(API가 끊김, 재부팅, 시간 초과). Helm은 마지막 리비전이
    #    pending이면 다른 작업이 진행 중이라 보고 upgrade를 거부하는데("another operation ... is in progress"), 그 helm이 이미 없어도 상태가
    #    남아 저절로 풀리지 않는다. failed(--wait 시간 초과 등)와 uninstalling(지우다 끊김)도 함께 정리한다.
    #  - 정리: 성공했던 리비전(deployed, 또는 그 뒤에 밀려난 superseded)이 있으면 그 가운데 마지막 것으로 rollback한다. 돌고 있는 ArgoCD를
    #    지우지 않고 마지막으로 성공한 설정으로 되돌린다(rollback은 pending 상태에서도 된다). 그런 리비전이 없으면(첫 설치가 끊기거나 실패했다)
    #    uninstall한다: 되돌아갈 곳이 없으니 반쯤 만든 리소스를 지우고 첫 부팅과 같은 설치를 다시 한다. --wait는 지운 리소스가 실제로 사라질
    #    때까지 기다린다(지워지는 중인 같은 이름의 객체가 남아 있으면 설치가 실패한다). CRD는 차트가 남기게 표시해 둬서 지워지지 않는다.
    # 정리한 뒤 상태가 deployed가 아닐 때만 설치한다(rollback이 성공하면 이미 deployed다).
    step "6/8 ArgoCD"
    argocd_status() {
      helm list -n argocd --filter '^argocd$' -o json |
        python3 -c 'import json, sys; r = json.load(sys.stdin); print(r[0]["status"] if r else "")'
    }
    st=$(argocd_status)
    case $st in
      pending-install|pending-upgrade|pending-rollback|failed|uninstalling)
        rev=$(helm history argocd -n argocd -o json |
          python3 -c 'import json, sys; print(max([r["revision"] for r in json.load(sys.stdin) if r["status"] in ("deployed", "superseded")], default=""))')
        if [ "$st" != uninstalling ] && [ -n "$rev" ]; then
          log "ArgoCD 릴리스가 $st: 성공했던 리비전 $rev(으)로 rollback"
          helm rollback argocd "$rev" -n argocd --wait --timeout 10m
        else
          log "ArgoCD 릴리스가 $st: uninstall하고 다시 설치"
          helm uninstall argocd -n argocd --wait --timeout 5m
        fi
        st=$(argocd_status) ;;
    esac
    if [ "$st" = deployed ]; then
      log "건너뜀: ArgoCD 설치됨"
    else
      log "ArgoCD 설치 (argo-cd $ARGOCD_CHART_VERSION)"
      helm upgrade --install argocd argo-cd --repo https://argoproj.github.io/argo-helm --version "$ARGOCD_CHART_VERSION" \
        -n argocd --create-namespace -f /etc/devops/argocd-values.yaml \
        --set server.ingress.enabled=false \
        --set configs.cm.url=http://localhost:8080 \
        --wait --timeout 10m
    fi

    # 7. DB 비밀번호 Secret: 없을 때만 만든다. 있는 것을 새 값으로 바꾸면 PostgreSQL 데이터(PVC)에 이미 들어간 비밀번호와 어긋난다.
    # 비밀번호는 파이프로만 흐른다: 명령줄 인자(ps)·로그·임시 파일에 쓰지 않는다. tr은 openssl이 끝에 붙이는 줄바꿈을 뺀다.
    # 저장은 된다: Secret은 k3s 데이터 저장소(/var/lib/rancher/k3s/server/db, 암호화된 EBS 볼륨)에 들어간다. k3s는 기본으로 Secret을
    # 따로 암호화하지 않으므로(base64일 뿐이다) 이 값을 지키는 것은 EBS 암호화다.
    # 네임스페이스를 미리 만드는 것은 ArgoCD가 앱을 띄우기 전에 Secret을 넣어 두려는 것이다(CreateNamespace=true는 있는 것을 건드리지 않는다).
    step "7/8 DB Secret"
    for ns in shortener-dev shortener-prod; do
      kubectl get namespace "$ns" >/dev/null 2>&1 || kubectl create namespace "$ns"
      if kubectl -n "$ns" get secret shortener-db >/dev/null 2>&1; then
        log "건너뜀: $ns/shortener-db 있음"
      else
        openssl rand -hex 16 | tr -d '\n' | kubectl -n "$ns" create secret generic shortener-db --from-file=password=/dev/stdin
      fi
    done

    # 8. 루트 Application: ArgoCD가 이것을 읽어 argocd/apps의 dev·prod Application을 만들고, 그 뒤 배포는 모두 ArgoCD가 한다.
    # CRD가 Established가 되기 전에 적용하면 "no matches for kind Application"으로 실패해서 먼저 기다린다.
    step "8/8 루트 Application"
    retry "Application CRD" 60 kubectl wait --for=condition=Established crd/applications.argoproj.io --timeout=5s
    if kubectl -n argocd get application root >/dev/null 2>&1; then
      log "건너뜀: 루트 Application 있음"
    else
      retry "루트 Application 적용 ($ROOT_APP_URL)" 120 kubectl apply -f "$ROOT_APP_URL"
    fi

    date -u +%FT%TZ >"$DONE"
    log "완료($(( $(date +%s) - START ))초). prod http://$DUCKDNS_SUBDOMAIN.duckdns.org, dev http://dev.$DUCKDNS_SUBDOMAIN.duckdns.org. ArgoCD UI는 port-forward로 본다(6단계 주석). 앱은 ArgoCD가 이어서 배포한다(kubectl -n argocd get applications)"
# DuckDNS 갱신: 서비스는 한 번 돌고 끝나는 oneshot이고, 타이머가 부팅 30초 뒤와 마지막 실행 5분 뒤마다 서비스를 다시 시작한다.
- path: /etc/systemd/system/duckdns-update.service
  content: |
    [Unit]
    Description=Point the DuckDNS name at this instance's public IPv4
    Wants=network-online.target
    After=network-online.target
    [Service]
    Type=oneshot
    ExecStart=/usr/local/bin/duckdns-update
- path: /etc/systemd/system/duckdns-update.timer
  content: |
    [Unit]
    Description=Run duckdns-update at boot and every 5 minutes
    [Timer]
    OnBootSec=30s
    OnUnitActiveSec=5min
    [Install]
    WantedBy=timers.target
# 부트스트랩: 부팅마다 돈다. 실패하면 90초 뒤 다시 하되, 첫 시작부터 3시간 안에 10번(첫 시작 포함)까지만 시작하고 넘으면 failed로 멈춘다.
# 재시도 사이 대기만 13.5분(9 × 90초)이라 금방 실패하는 일시적 문제도 20분 넘게 다시 해 보고(전에는 60초·3번이라 약 3분 만에 멈췄다),
# 4단계 상한(600초)에서 실패하는 시도도 대기를 더해 한 번에 약 12분이라 10번이 3시간 안에 든다. 시도마다 TimeoutStartSec까지 걸리면
# 3시간 안에 10번이 차지 않고, 3시간이 지나면 횟수를 처음부터 다시 세므로 재시도가 멈추지 않는다. 그 3시간 안에는 손으로 한
# systemctl start도 시작 제한에 걸려 거부되므로, systemctl reset-failed devops-bootstrap으로 횟수를 지운 뒤 시작하거나
# /usr/local/sbin/devops-bootstrap을 직접 돌린다. 진행은 /var/log/devops-bootstrap.log, 성공하면 /var/lib/devops-bootstrap.done이 생긴다.
# oneshot은 시작 제한 시간이 기본으로 꺼져 있어서 60분으로 묶는다. 스크립트의 대기 상한을 다 더하면 약 47분이다: apt 약 7분, DuckDNS 2분,
# k3s 안정 확인 약 10분, helm 정리와 설치 최대 25분(uninstall 5분. 설치의 --timeout 10m은 pre-install 훅 Job 대기와 리소스 대기에 따로 걸린다),
# CRD·루트 앱 약 3분. 내려받기·설치 시간을 더해도 60분 안에 들고, 60분에 끊기는 것은 상한이 없는 단계(내려받기, k3s 설치 스크립트)가 멈췄을 때다.
# WantedBy=multi-user.target인 oneshot이라 재부팅마다 부팅 완료(multi-user.target)가 이 실행을 기다린다(k3s 안정 확인 30초를 포함해 보통 1분 안팎).
# 의도한 것이고, k3s와 SSM 에이전트는 이 서비스를 기다리지 않고 함께 뜬다.
- path: /etc/systemd/system/devops-bootstrap.service
  content: |
    [Unit]
    Description=Bootstrap k3s, ArgoCD and the app-of-apps (idempotent, every boot)
    Wants=network-online.target
    After=network-online.target
    StartLimitIntervalSec=3h
    StartLimitBurst=10
    [Service]
    Type=oneshot
    ExecStart=/usr/local/sbin/devops-bootstrap
    TimeoutStartSec=60min
    Restart=on-failure
    RestartSec=90s
    [Install]
    WantedBy=multi-user.target
# 첫 부팅에 한 번: 새 유닛 파일을 읽히고(daemon-reload) 부트스트랩을 켜서(enable) 다음 부팅부터는 systemd가 돌리게 한다.
# --no-block: 10분 가까운 설치를 cloud-init 안에서 붙잡고 기다리지 않는다. 그래서 cloud-init status --wait는 설치가 끝나기 전에 done이 된다.
# 진행은 위 로그와 완료 표시로 보고, 실패하면 재시도는 systemd가 한다.
runcmd:
- [systemctl, daemon-reload]
- [systemctl, enable, devops-bootstrap.service]
- [systemctl, start, --no-block, devops-bootstrap.service]
