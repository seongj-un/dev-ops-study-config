#cloud-config
# 새 Ubuntu 24.04 EC2를 GitOps 노드(DuckDNS → k3s → ArgoCD → app-of-apps)로 만든다. ec2.tf가 templatefile로 렌더링해 user data로 넘긴다.
# write_files·runcmd는 인스턴스의 첫 부팅에만 돈다. 그래서 설치는 부팅마다 도는 devops-bootstrap.service가 하고, 이미 된 단계는 건너뛴다.
# Terraform 템플릿에서 "$${"와 "%%{"는 보간·지시문의 시작이다(이 원본에서는 겹쳐 써서 글자 그대로 내보낸다). 그래서 Terraform 값은
# bootstrap.env와 argocd-values.yaml에만 넣고, 스크립트·유닛에는 이 조합을 쓰지 않는다(셸 변수는 $VAR 모양만). Terraform이 스크립트를 바꾸지 않는다.
# EC2 user data 한도(16384바이트)는 ec2.tf가 base64gzip으로 압축해 넘기는 gzip 바이트에 걸린다. 압축 전 원문은 16KB를 넘어도 된다.
# test/render.sh가 Terraform과 같은 압축본을 만들어 그 크기와 압축을 푼 결과를 보고, 스크립트가 렌더링 전후로 같은지도 검사한다.
write_files:
# Terraform이 넘긴 값(스크립트가 source 한다). 비밀은 없다: DuckDNS 토큰은 SSM 파라미터 이름만 적고 값은 부팅 때 읽는다.
# regex()는 값 전체가 패턴에 맞으면 그 값을, 아니면 plan에서 오류를 낸다: root가 source 하는 파일에 셸 문법이 끼어들지 못한다.
# ROOT_APP_URL: https://github.com/<owner>/<repo>[.git]의 raw 주소 https://raw.githubusercontent.com/<owner>/<repo>/<ref>/<경로>
- path: /etc/devops/bootstrap.env
  permissions: "0644"
  content: |
    AWS_REGION=${regex("^[a-z0-9-]+$", aws_region)}
    SSM_PARAMETER_NAME=${regex("^[A-Za-z0-9_./-]+$", ssm_parameter_name)}
    DUCKDNS_SUBDOMAIN=${regex("^[a-z0-9-]+$", duckdns_subdomain)}
    K3S_VERSION=${regex("^v[0-9]+[.][0-9]+[.][0-9]+[+]k3s[0-9]+$", k3s_version)}
    HELM_VERSION=${regex("^v[0-9]+[.][0-9]+[.][0-9]+$", helm_version)}
    ARGOCD_CHART_VERSION=${regex("^[0-9]+[.][0-9]+[.][0-9]+$", argocd_chart_version)}
    ROOT_APP_URL=https://raw.githubusercontent.com/${regex("^https://github[.]com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?)(?:[.]git)?$", config_repo_url)[0]}/${regex("^[A-Za-z0-9_./-]+$", config_repo_ref)}/argocd/root.yaml
# ArgoCD 값: bootstrap/argocd/values.yaml에서 주석 줄과 빈 줄만 뺀다(9.7KB → 약 1KB). render.sh가 두 YAML의 값이 같은지 비교한다.
# 주석·빈 줄만 고친 커밋은 렌더링 결과를 바꾸지 않아서 인스턴스를 다시 만들지도 않는다(user_data_replace_on_change).
- path: /etc/devops/argocd-values.yaml
  permissions: "0644"
  content: |
    ${indent(4, join("\n", [for l in split("\n", argocd_values) : l if trimspace(l) != "" && !startswith(trimspace(l), "#")]))}
# AWS CLI 팀의 PGP 공개 키. 2단계가 AWS CLI zip의 서명을 이 키로 검사한다. AWS CLI 설치 문서
# (https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html)의 블록 그대로다(2026-10-01 확인).
# 지문 FB5D B77F D5C1 18B8 0511 ADA8 A631 0ACC 4672 475C(render.sh가 확인한다), 만료 2027-07-01. AWS가 키를 바꾸면 검사가 실패해
# 2단계에서 멈추므로 문서의 새 블록으로 바꾼다. 만료일이 다가올 때도 문서에서 만료일을 늘린 블록을 받아 바꾼다.
