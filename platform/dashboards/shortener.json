    {
      "id": 9,
      "type": "timeseries",
      "title": "단축 URL 생성·리다이렉트 (초당)",
      "description": "앱이 직접 세는 카운터: shortener_urls_shortened_total(단축 URL을 만들 때), shortener_redirects_total(짧은 주소로 리다이렉트할 때).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(shortener_urls_shortened_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "단축 URL 생성"
        },
        {
