{
  "uid": "shortener",
  "title": "Shortener",
  "description": "URL 단축 서비스(dev·prod): SLO, 트래픽, 지연, 캐시, ERROR 로그. 이 대시보드는 Git(platform/dashboards/shortener.json)에서 온다. UI에서 고친 것은 저장되지 않는다.",
  "tags": [
    "shortener",
    "slo",
    "logs"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "환경",
        "type": "custom",
        "query": "dev : shortener-dev,prod : shortener-prod",
        "description": "앱 차트가 배포된 네임스페이스. 모든 패널이 namespace=\"$namespace\"로 고른다.",
        "current": {
          "text": "prod",
          "value": "shortener-prod"
        },
        "options": [
          {
            "text": "dev",
            "value": "shortener-dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "shortener-prod",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "availability_objective",
        "type": "constant",
        "query": "99.5",
        "hide": 2,
        "description": "가용성 SLO 목표(%). 앱 차트 values.yaml의 slo.availability.objective와 같게 둔다."
      },
      {
        "name": "latency_objective",
        "type": "constant",
        "query": "99",
        "hide": 2,
        "description": "지연 SLO 목표(%). 앱 차트 values.yaml의 slo.latency.objective와 같게 둔다."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "가용성 (1시간)",
      "description": "최근 1시간 동안 5xx가 아닌 응답의 비율(1 - 5xx 비율). 차트의 SLO 기록 규칙 namespace_job:http_server_requests_errors:ratio_rate1h를 읽는다. 목표 99.5%보다 낮으면 빨간색. 요청이 없으면 0 ÷ 0이라 '요청 없음'으로 보인다.",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "1 - namespace_job:http_server_requests_errors:ratio_rate1h{namespace=\"$namespace\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "요청 없음",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
