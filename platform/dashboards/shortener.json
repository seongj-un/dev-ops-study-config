              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "ERROR 로그",
      "description": "앱 컨테이너의 level=\"ERROR\" 로그(Loki). | json이 ECS JSON의 필드를 꺼내고(중첩 키는 밑줄로 이어진다: log.logger → log_logger), line_format이 '로거: 메시지 (예외 종류: 예외 메시지)'로 줄인다. 줄을 펼치면 error_stack_trace 등 모든 필드가 보인다.",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "{namespace=\"$namespace\", app=\"shortener\", container=\"shortener\", level=\"ERROR\"}\n| json\n| line_format `{{.log_logger}}: {{.message}}{{if .error_type}} ({{.error_type}}: {{.error_message}}){{end}}`",
          "queryType": "range"
